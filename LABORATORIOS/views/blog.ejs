<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Blog</title>
    <link rel="stylesheet" href="/styleCadLog.css">
</head>
<body>
    <h1>Blog</h1>

    <form action="/cadastrar_post.html" method="get">
        <button type="submit">Criar post</button>
    </form>

    <% for (let i = 0; i < posts.length; i++) { %>
    <article>
        <h2><%= posts[i].titulo %></h2>
        <p><%= posts[i].resumo %></p>
        <p><%= posts[i].conteudo %></p>
    </article>
<% } %>

</body>
</html>